# Test http requests for my api
@apiUrl = http://localhost:3000/api


### Get server root
GET http://localhost:3000/

### Get api root
GET http://localhost:3000/api

### Get not found 404
GET http://localhost:3000/something-not-found

### Post server root
POST http://localhost:3000/

##################
## /media requests
##################

### GET all media items
GET {{apiUrl}}/media

### GET 3 latest media items
GET {{apiUrl}}/media?limit=2

### GET media item by id
GET {{apiUrl}}/media/9626

### GET media item by id (Not found)
GET {{apiUrl}}/media/0

### Add new media item
POST {{apiUrl}}/media
content-type: application/json

{
  "filename": "60ac.jpg",
  "title": "New image",
  "description": "The description of the new image",
  "user_id": 305,
  "media_type": "image/jpeg"
}

### Add new media item (Bad request, title missing)
POST {{apiUrl}}/media
content-type: application/json

{
  "filename": "60ac.jpg",
  "description": "The description of the new image",
  "user_id": 305,
  "media_type": "image/jpeg"
}

### Modify existing media item 
PUT {{apiUrl}}/media/9632
content-type: application/json

{
  "description": "updated desc",
  "title": "Uus title"
}

### Delete media item 
DELETE {{apiUrl}}/media/9625

